generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  BREAK
  UNAVAILABLE
}

model Barber {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  timezone        String                 @default("America/Bogota")
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  services        BarberService[]
  weeklySchedules WeeklySchedule[]
  bookings        Booking[]
  overrides       AvailabilityOverride[]
  blockedPeriods  BlockedPeriod[]

  @@index([isActive])
}

model Service {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  priceInCents    Int?
  durationMinutes Int
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  barbers         BarberService[]
  bookings        Booking[]

  @@index([isActive])
}

// Join model keeps services reusable if more barbers are added later.
model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}

model WeeklySchedule {
  id        String  @id @default(cuid())
  barberId  String
  weekday   Int     // 0 = Sunday ... 6 = Saturday, matching JavaScript Date.
  startTime String  // Local time in HH:mm format.
  endTime   String  // Local time in HH:mm format.
  isActive  Boolean @default(true)
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startTime, endTime])
  @@index([barberId, weekday, isActive])
}

model Booking {
  id              String        @id @default(cuid())
  barberId        String
  serviceId       String
  customerName    String
  customerPhone   String
  dateKey         String        // Local date in YYYY-MM-DD; avoids UTC date shifts.
  startTime       String        // Local time in HH:mm, interpreted in barber timezone.
  durationMinutes Int           // Snapshot of the service estimate at booking time.
  status          BookingStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  barber          Barber        @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([barberId, dateKey, startTime])
  @@index([barberId, dateKey, status])
  @@index([customerPhone])
}

// Date-specific availability state for exceptional hours, pauses, or live status.
model AvailabilityOverride {
  id        String             @id @default(cuid())
  barberId  String
  dateKey   String             // Local date in YYYY-MM-DD.
  startTime String
  endTime   String
  status    AvailabilityStatus
  note      String?
  barber    Barber             @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dateKey, startTime])
}

model BlockedPeriod {
  id        String   @id @default(cuid())
  barberId  String
  dateKey   String   // Local date in YYYY-MM-DD.
  startTime String
  endTime   String
  reason    String?
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dateKey, startTime])
}
